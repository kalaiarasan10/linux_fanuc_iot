# ── Machine identity ────────────────────────────────────────────────────────────
MACHINE_ID=MCH-20260515-XXXX
MACHINE_TOKEN=your-machine-token-from-admin-panel

# ── FANUC CNC connection ────────────────────────────────────────────────────────
FANUC_IP=192.168.1.22
FANUC_PORT=8193
FANUC_TIMEOUT=10

# ── Server connection ───────────────────────────────────────────────────────────
SERVER_URL=https://iot.metalcraftsolutions.xyz

# ── PMC signal addresses ────────────────────────────────────────────────────────
PMC_AUTO_EXEC_BYTE=0
PMC_AUTO_EXEC_BIT=7
PMC_CUTTING_BYTE=2
PMC_CUTTING_BIT=6
PMC_SPINDLE_CW_BYTE=70
PMC_SPINDLE_CW_BIT=5
PMC_SPINDLE_CCW_BYTE=70
PMC_SPINDLE_CCW_BIT=4
PMC_FEED_HOLD_BYTE=0
PMC_FEED_HOLD_BIT=4
PMC_BLOCK_STOP_BYTE=46
PMC_BLOCK_STOP_BIT=1

# ── Macro variables to read ────────────────────────────────────────────────────
MACRO_VARS=3901:Parts Done,3902:Parts Required
